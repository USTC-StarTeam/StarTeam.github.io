---
import type { Publication } from "../lib/content";

interface Props {
  pubs: Publication[];
  id?: string;
}
const { pubs, id } = Astro.props;
const formatCount = new Intl.NumberFormat("en-US");
---

<ol id={id} class="selected-publications" role="list">
  {
    pubs.map((p) => {
      const d = p.data;
      const doiUrl = d.doi ? `https://doi.org/${d.doi}` : undefined;
      const titleUrl = d.url ?? doiUrl;
      const venueHasYear = d.journal?.includes(String(d.year));
      const hasCitation = typeof d.citations === "number" && Number.isFinite(d.citations);
      const citationVisible = hasCitation;
      const researchTopics = d.researchTopics ?? [];
      const search = [d.title, ...d.authors, d.method, d.journal, d.category, ...researchTopics, d.year]
        .filter(Boolean).join(" ").normalize("NFKC").toLowerCase();
      return (
        <li
          class="publication"
          data-pub
          data-publication-id={p.id}
          data-catalog-id={d.catalogId ?? ""}
          data-title={d.title}
          data-search={search}
          data-year={d.year}
          data-category={d.category ?? ""}
          data-citations={hasCitation ? d.citations : ""}
          data-citation-known={String(hasCitation)}
        >
          <div class="publication-rail">
            <span class="publication-method">{d.method ?? d.catalogId ?? String(d.year)}</span>
            {citationVisible && (
              <span
                class="publication-citations"
              >
                <span>OpenAlex</span><strong>{formatCount.format(d.citations!)}</strong>
              </span>
            )}
          </div>
          <div class="publication-body">
            <h3 class="publication-title">
              {titleUrl ? (
                <a href={titleUrl} target="_blank" rel="noopener noreferrer">{d.title}</a>
              ) : d.title}
            </h3>
            {d.authors.length > 0 && (
              <p class="publication-authors">
                {d.authors.map((author, authorIndex) => (
                  <Fragment>
                    {authorIndex > 0 && ", "}
                    {author === "Hao Wang" ? <strong>{author}</strong> : author}
                  </Fragment>
                ))}
              </p>
            )}
            <p class="publication-venue">
              {d.journal}
              {!venueHasYear && <>{d.journal && " · "}{d.year}</>}
            </p>
            {d.awards.length > 0 && (
              <div class="publication-awards" aria-label="论文荣誉">
                {d.awards.map(award => <span class="publication-award">{award}</span>)}
              </div>
            )}
            {(d.category || researchTopics.length > 0) && (
              <p class="publication-topics" lang="zh-CN">
                {d.category && <span class="publication-category">{d.category}</span>}
                {researchTopics.map(topic => <span>{topic}</span>)}
              </p>
            )}
            {d.summary && <p class="publication-summary" lang="zh-CN">{d.summary}</p>}
            {(d.url || d.code || doiUrl) && (
              <div class="publication-resources">
                {d.url && <a href={d.url} target="_blank" rel="noopener noreferrer" aria-label={`Paper: ${d.title}`}>Paper</a>}
                {d.code && <a href={d.code} target="_blank" rel="noopener noreferrer" aria-label={`Code: ${d.title}`}>Code</a>}
                {doiUrl && <a href={doiUrl} target="_blank" rel="noopener noreferrer" aria-label={`DOI: ${d.title}`}>DOI</a>}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .selected-publications {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-slate-200, #e2e8f0);
  }
  .publication {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1.75rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-slate-200, #e2e8f0);
  }
  .publication[hidden] { display: none; }
  .publication-rail { min-width: 0; padding-top: 0.2rem; }
  .publication-method {
    display: block;
    color: var(--color-accent-700, #97226b);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .publication-citations {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.45rem;
    margin-top: 0.65rem;
    color: var(--color-slate-600, #475569);
    font-size: 0.75rem;
    line-height: 1.7;
    font-variant-numeric: tabular-nums;
  }
  .publication-citations strong { color: var(--color-primary-800, #103f68); font-size: 1.125rem; font-weight: 500; }
  .publication-body { min-width: 0; }
  .publication-title {
    margin: 0;
    color: var(--color-primary-950, #08213a);
    font-family: var(--font-sans);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.6;
    text-wrap: initial;
    overflow-wrap: anywhere;
  }
  .publication-title a { color: inherit; text-decoration: none; }
  .publication-title a:hover { color: var(--color-primary-700, #124d80); text-decoration: underline; text-underline-offset: 0.2em; }
  .publication-authors,
  .publication-venue {
    margin: 0.4rem 0 0;
    color: var(--color-slate-600, #475569);
    font-size: 0.9rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .publication-authors strong { color: var(--color-primary-900, #0d3252); font-weight: 600; }
  .publication-venue { margin-top: 0.25rem; color: var(--color-primary-800, #103f68); }
  .publication-awards { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.55rem; }
  .publication-award { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-200, #f6b9df); border-radius: 999px; padding: 0.22rem 0.7rem; background: var(--color-accent-50, #fdeff8); color: var(--color-accent-800, #7c1f59); font-size: 0.82rem; font-weight: 600; line-height: 1.5; }
  .publication-topics { display: flex; flex-wrap: wrap; gap: 0.3rem 0.7rem; margin: 0.55rem 0 0; color: var(--color-slate-500, #64748b); font-size: 0.78rem; line-height: 1.8; }
  .publication-topics>span { max-width: 100%; overflow-wrap: anywhere; }
  .publication-category { color: var(--color-primary-700, #124d80); }
  .publication-summary { margin: 0.65rem 0 0; color: var(--color-slate-700, #334155); font-size: 0.96rem; line-height: 1.85; overflow-wrap: anywhere; }
  .publication-resources { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-top: 0.6rem; font-size: 0.88rem; line-height: 1.8; }
  .publication-resources a { color: var(--color-primary-700, #124d80); text-decoration: underline; text-decoration-color: var(--color-primary-200, #aed3ef); text-underline-offset: 0.2em; }
  .publication-resources a:hover { color: var(--color-accent-700, #97226b); text-decoration-color: currentColor; }
  @media (max-width: 639px) {
    .publication { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; padding: 1.35rem 0; }
    .publication-rail { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.3rem 1rem; padding-top: 0; }
    .publication-method { min-width: 0; }
    .publication-citations { margin-top: 0; }
    .publication-citations strong { font-size: 1rem; }
  }
</style>
