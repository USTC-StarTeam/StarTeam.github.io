---
import { architectureLayers } from "../data/architecture";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const researchPath = `${basePath}research`;
---

<div class="architecture-stage" data-card-deck>
  <div class="deck-toolbar">
    <div class="deck-selectors" role="group" aria-label="进入对应研究层级">
      {architectureLayers.map(layer => <a class="deck-selector" href={`${researchPath}#layer-${layer.id}`} data-select-layer={layer.id} aria-label={`查看 ${layer.title}：${layer.chinese}`}><span>{layer.number}</span>{layer.title}</a>)}
    </div>
    <p class="deck-instruction">悬停预览，点击进入对应研究部分 <span aria-hidden="true">↗</span></p>
  </div>
  <div class="architecture-cards">
    <div class="deck-backing" aria-hidden="true"></div>
    {architectureLayers.map((layer, index) => (
      <a id={`layer-${layer.id}`} class={`layer-card layer-${layer.id}`} href={`${researchPath}#layer-${layer.id}`} style={`--layer:${index}`} data-layer={layer.id} aria-label={`查看 ${layer.title}：${layer.chinese}`}>
        <div class="card-topline"><span>{layer.number} / SYSTEM LAYER</span><span class="card-extract" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none"><path d="M5 15 15 5 M6 5h9v9" /></svg></span></div>
        <h3 id={`card-title-${layer.id}`}>{layer.title}</h3>
        <p class="layer-chinese">{layer.chinese}</p>
        <p class="layer-description">{layer.description}</p>
        <ul class="layer-tags" aria-label={`${layer.title} 内容`}>
          {layer.tags.map(tag => <li>{tag}</li>)}
        </ul>
        <div class="card-bottomline"><span class="card-indicator" aria-hidden="true"></span><p>{layer.note}</p></div>
      </a>
    ))}
  </div>
  <div class="deck-bottomline"><button type="button" class="deck-reset" data-deck-reset>收回卡片 <span aria-hidden="true">↙</span></button></div>
  <p class="sr-only" aria-live="polite" data-deck-status></p>
</div>
<p class="architecture-note">应用提出问题，运行带来反馈；数据、模型与框架在验证中持续改进。</p>

<script>
  const deck = document.querySelector<HTMLElement>("[data-card-deck]");
  if (deck) {
    const cards = [...deck.querySelectorAll<HTMLAnchorElement>("[data-layer]")];
    const selectors = [...deck.querySelectorAll<HTMLAnchorElement>("[data-select-layer]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");
    let pinned = "";
    let active = "";
    const select = (id: string, announce = false) => {
      deck.classList.add("has-entered");
      active = id;
      deck.dataset.active = id;
      cards.forEach(card => {
        const selected = card.dataset.layer === id;
        card.classList.toggle("is-extracted", selected);
      });
      selectors.forEach(link => link.classList.toggle("is-previewed", link.dataset.selectLayer === id));
      if (announce) {
        const status = deck.querySelector<HTMLElement>("[data-deck-status]");
        if (status) status.textContent = id ? `已抽出 ${cards.find(card => card.dataset.layer === id)?.querySelector("h3")?.textContent} 卡片` : "已收回全部卡片";
      }
    };
    // Native links navigate on click/Enter, even with JavaScript disabled.
    // Hover and focus only preview the deck; they never intercept navigation.
    selectors.forEach(link => {
      const id = link.dataset.selectLayer ?? "";
      link.addEventListener("pointerenter", () => { if (canHover.matches) select(id); });
      link.addEventListener("focus", () => select(id));
      link.addEventListener("blur", () => select(pinned));
    });
    cards.forEach(card => {
      const id = card.dataset.layer ?? "";
      card.addEventListener("pointerenter", () => { if (canHover.matches) select(id); });
      // Keep the preview while crossing the space its pulled-out edge leaves,
      // rather than snapping it back under the pointer and causing hover jitter.
      card.addEventListener("focusin", () => select(id));
      card.addEventListener("focusout", event => {
        if (!card.contains(event.relatedTarget as Node | null)) select(pinned);
      });
    });
    deck.addEventListener("pointerleave", () => {
      if (canHover.matches && !deck.contains(document.activeElement)) select(pinned);
    });
    deck.querySelector("[data-deck-reset]")?.addEventListener("click", () => { pinned = ""; select("", true); });
    deck.addEventListener("keydown", event => {
      if (event.key === "Escape" && active) { pinned = ""; select("", true); }
    });
    deck.dataset.enhanced = "true";
    const reveal = () => deck.classList.add("is-ready");
    deck.addEventListener("animationend", event => {
      if (event.animationName.startsWith("deck-draw") && event.target === cards[cards.length - 1]) deck.classList.add("has-entered");
    });
    if (reducedMotion.matches) reveal();
    else {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { reveal(); observer.disconnect(); }
      }, { threshold: .18 });
      observer.observe(deck);
    }
    // Selecting a layer via the icon's anchor also pulls its card out.
    window.addEventListener("hashchange", () => {
      const target = location.hash.replace("#layer-", "");
      if (cards.some(card => card.dataset.layer === target)) { pinned = target; reveal(); select(target, true); }
    });
    if (location.hash.startsWith("#layer-")) {
      const target = location.hash.slice(7);
      if (cards.some(card => card.dataset.layer === target)) { pinned = target; reveal(); select(target); }
    }
  }
</script>

<style>
  .architecture-stage { position:relative; isolation:isolate; padding-top:1.75rem; }
  .architecture-stage::before { content:""; position:absolute; inset:10% -1rem 2%; z-index:-1; background:radial-gradient(ellipse at 50% 70%,#dcebf7 0%,#edf5fb 44%,transparent 73%); }
  .deck-toolbar { position:relative; z-index:30; display:flex; flex-wrap:wrap; align-items:center; justify-content:flex-start; gap:1rem; margin-bottom:.75rem; }
  .deck-selectors { display:flex; flex-wrap:wrap; gap:.3rem; padding:.3rem; border:1px solid #d5e2ed; border-radius:.8rem; background:#ffffffa8; }
  .deck-selector { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; border:1px solid transparent; border-radius:.55rem; background:transparent; color:#526780; padding:.5rem .65rem; font-size:.84rem; line-height:1.4; cursor:pointer; }
  .deck-selector>span { color:#8ca1b5; font-size:.65rem; }
  .deck-selector:hover { color:#124d80; background:#f0f7fd; }
  .deck-selector.is-previewed { background:#fff; border-color:#c4d9ea; color:#124d80; box-shadow:0 2px 6px #153d6510; }
  .deck-instruction { color:#61768f; font-size:.8rem; line-height:1.7; }
  .deck-instruction span { color:#b92d85; }
  .layer-card,.deck-selector { text-decoration:none; }
  .layer-card:focus-visible { outline:2px solid #1f73b8; outline-offset:4px; }
  .architecture-cards { position:relative; display:grid; grid-template-columns:minmax(0,1fr); align-items:start; margin:0 1.3rem; padding:4.5rem 0 3rem; }
  .deck-backing { position:absolute; left:3%; right:1%; top:13rem; height:15rem; border:1px solid #d5e3ef; border-radius:1.3rem; background:linear-gradient(150deg,#e5eef7,#edf5fb); transform:translate3d(0,0,0); box-shadow:0 24px 28px -25px #244b7a50; }
  .deck-backing::before,.deck-backing::after { content:""; position:absolute; inset:.5rem -.18rem -.5rem .18rem; z-index:-1; border:1px solid #cbdcea; border-radius:inherit; background:#e9f1f8; }
  .deck-backing::after { inset:1rem -.35rem -1rem .35rem; z-index:-2; background:#e1ecf5; }
  .layer-card { --card-tint:#edf5fc; --card-edge:#bed5e8; position:relative; grid-area:1/1; margin-left:calc(var(--layer) * 18.6%); margin-top:calc(var(--layer) * 2.25rem); width:43%; display:flex; flex-direction:column; min-width:0; min-height:18.5rem; padding:1.35rem 1.6rem 1.05rem; border:1px solid var(--card-edge); border-top-color:#fff; border-radius:1.15rem; background:linear-gradient(140deg,#ffffff 8%,var(--card-tint)); box-shadow:inset 0 1px 0 #fff,0 20px 30px -20px #234d7c55,3px 4px 0 -2px #cddfec; transform:translate3d(0,0,0); transform-origin:center; scroll-margin-top:8rem; z-index:calc(var(--layer) + 1); cursor:pointer; transition:transform .65s cubic-bezier(.2,.8,.2,1),box-shadow .45s ease,border-color .45s ease; }
  .layer-model { --card-tint:#edf2fc; --card-edge:#c3d1e8; }
  .layer-harness { --card-tint:#f0effb; --card-edge:#cecae6; }
  .layer-application { --card-tint:#edf7f5; --card-edge:#bedbd6; }
  .architecture-stage[data-enhanced]:not(.is-ready) .layer-card { transform:translate3d(calc((1.5 - var(--layer)) * 43.25%),calc((1.5 - var(--layer)) * 2.25rem),0); }
  .architecture-stage.is-ready:not(.has-entered) .layer-card { animation:deck-draw .95s cubic-bezier(.16,1,.3,1) both; animation-delay:calc(var(--layer) * .12s); }
  .layer-card.is-extracted { z-index:20; transform:translate3d(0,-2.8rem,0); border-color:#84b6db; box-shadow:0 28px 40px -20px #173f6e70,0 2px 5px #204a7820; }
  .architecture-stage.is-ready .layer-card.is-extracted { animation:none; }
  .card-topline { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.6rem; color:#61768f; font-size:.6rem; letter-spacing:.12em; line-height:1.5; }
  .card-extract { display:grid; place-items:center; width:1.75rem; height:1.75rem; flex-shrink:0; margin:-.25rem -.5rem -.15rem 0; border:1px solid #cfdeeb; border-radius:50%; background:#ffffffa8; color:#8da7bd; cursor:pointer; }
  .card-extract svg { width:.85rem; height:.85rem; stroke:currentColor; stroke-width:1.5; }
  .layer-card:hover .card-extract,.layer-card:focus-visible .card-extract { color:#b92d85; border-color:#e8bcda; background:#fff; }
  .layer-card h3 { font-family:var(--font-sans); font-size:clamp(1.35rem,2.1vw,1.8rem); font-weight:500; line-height:1.15; letter-spacing:-.04em; color:#183e63; }
  .layer-chinese { margin-top:.4rem; font-size:.88rem; color:#5f7490; letter-spacing:.04em; }
  .layer-description { margin-top:1.05rem; color:#485f79; font-size:.95rem; line-height:1.9; }
  .layer-tags { display:flex; flex-wrap:wrap; gap:.55rem .5rem; margin:1.1rem 0 1.3rem; padding:0; list-style:none; max-width:22rem; }
  .layer-tags li { border:1px solid #bfd2e3; border-radius:999px; padding:.38rem .8rem; background:#ffffffc9; color:#2b4a67; font-size:.9rem; line-height:1.5; white-space:normal; }
  .card-bottomline { display:flex; align-items:flex-start; gap:.5rem; border-top:1px solid #d0deea; padding-top:.8rem; margin-top:auto; }
  .card-indicator { display:block; flex-shrink:0; width:.32rem; height:.32rem; border-radius:50%; background:#d6409f; box-shadow:0 0 0 3px #f7e7f2; margin:.4rem .1rem 0; }
  .card-bottomline p { font-size:.78rem; color:#65778c; line-height:1.8; }
  .deck-bottomline { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:.75rem; border-top:1px solid #d3e2ef; padding:1rem .25rem 0; }
  .deck-reset { border:0; background:transparent; color:#526780; padding:.3rem; font-size:.8rem; cursor:pointer; }
  .deck-reset:hover { color:#b92d85; }
  .architecture-note { margin:1.75rem auto 0; text-align:center; font-size:.86rem; color:#526780; line-height:1.9; }
  @keyframes deck-draw {
    from { transform:translate3d(calc((1.5 - var(--layer)) * 43.25%),calc((1.5 - var(--layer)) * 2.25rem),0); }
    to { transform:translate3d(0,0,0); }
  }
  @media(max-width:1023px) {
    .deck-toolbar { flex-direction:column; align-items:flex-start; }
    .architecture-cards { margin:0 .9rem; row-gap:2rem; }
    .layer-card { width:68%; margin-left:0; margin-top:0; min-height:18rem; padding:1.25rem 1.5rem; }
    .layer-card:nth-of-type(even) { margin-left:28%; margin-top:2.25rem; }
    .layer-harness,.layer-application { grid-area:2/1; }
    .deck-backing { left:8%; right:8%; top:15rem; bottom:3rem; height:auto; transform:translate3d(0,0,0); }
    .layer-card h3 { font-size:1.65rem; }
    .architecture-stage[data-enhanced]:not(.is-ready) .layer-card { transform:translate3d(0,2rem,0); }
    .architecture-stage.is-ready .layer-card { animation-name:deck-draw-small; }
  }
  @keyframes deck-draw-small {
    from { opacity:.6; transform:translate3d(-12%,3rem,0); }
    to { opacity:1; transform:translate3d(0,0,0); }
  }
  @media(max-width:599px) {
    .architecture-stage { padding-top:1.25rem; }
    .architecture-stage::before { inset:3rem 0 2rem; }
    .deck-toolbar { gap:.7rem; }
    .deck-selectors { width:100%; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.2rem; }
    .deck-selector { font-size:.8rem; padding:.45rem .4rem; justify-content:flex-start; }
    .architecture-cards { display:flex; flex-direction:column; min-height:0; margin:2rem .55rem 1.5rem; padding:0; }
    .deck-backing { inset:2rem -.2rem 0; height:auto; transform:translate3d(0,0,0); border-radius:1rem; }
    .layer-card,.layer-card:nth-of-type(even) { position:relative; width:100%; margin-left:0; min-height:0; padding:1.2rem 1.25rem; transform:translate3d(0,0,0); margin-top:-1.6rem; }
    .layer-card:first-of-type { margin-top:0; }
    .layer-card.is-extracted { transform:translate3d(0,-1rem,0); }
    .architecture-stage.is-ready .layer-card { animation-name:deck-draw-mobile; }
    .architecture-stage.is-ready .layer-card.is-extracted { animation:none; }
    .card-topline { font-size:.58rem; }
    .layer-card h3 { font-size:1.6rem; }
    .layer-chinese { font-size:.84rem; }
    .layer-description { margin-top:.75rem; font-size:.9rem; }
    .layer-tags { margin:.85rem 0 1rem; gap:.4rem; }
    .layer-tags li { font-size:.84rem; padding:.3rem .6rem; }
    .card-bottomline { padding-top:.7rem; }
    .card-bottomline p { font-size:.74rem; }
    .architecture-note { margin-top:1rem; }
  }
  @keyframes deck-draw-mobile {
    from { opacity:.6; transform:translate3d(-.5rem,2.5rem,0); }
    to { opacity:1; transform:translate3d(0,0,0); }
  }
  @media(prefers-reduced-motion:reduce) {
    .layer-card { transition:none; }
    .architecture-stage.is-ready .layer-card { animation:none; }
  }
</style>
