---
import { Image } from "astro:assets";
import BaseLayout from "../components/BaseLayout.astro";
import PipelineHero from "../components/PipelineHero.astro";
import ArchitectureCards from "../components/ArchitectureCards.astro";
import SelectedPublications from "../components/SelectedPublications.astro";
import { site } from "../data/site";
import { getPublications } from "../lib/content";
import labPhoto from "../assets/gallery/sample-1.jpg";

const selected = (await getPublications()).filter(
  paper => paper.data.featured && paper.data.authors.includes("Hao Wang"),
);
---

<BaseLayout>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white">
    <div class="container-page py-16 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold tracking-wide text-accent-600 uppercase">
          {site.institution} · {site.university}
        </p>
        <h1
          class="mt-4 text-4xl leading-tight font-semibold text-slate-900 sm:text-5xl"
        >
          {site.name}
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">{site.description}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/research"
            class="rounded-md bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-800"
            >Explore our research</a
          >
          <a
            href="/people"
            class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
            >Meet the team</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Four cooperating elements: icons, architecture, selected evidence. -->
  <section class="border-y border-slate-200 bg-white" aria-label="Data, Model, Harness and Application">
    <div class="container-page py-12 sm:py-14">
      <PipelineHero />
    </div>
  </section>

  <section class="architecture-section" aria-labelledby="architecture-title">
    <div class="container-page py-14 sm:py-16">
      <div class="home-section-heading">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 id="architecture-title" class="font-serif text-3xl text-slate-900">From data to application</h2>
          <p class="home-section-lead">数据、模型与运行框架，在真实问题中连接。</p>
        </div>
        <p class="home-section-aside">四个要素 · 协同与反馈</p>
      </div>
      <ArchitectureCards />
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white" aria-labelledby="selected-title">
    <div class="container-page py-14 sm:py-16">
      <div class="home-section-heading mb-8">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 id="selected-title" class="font-serif text-3xl text-slate-900">Selected publications</h2>
          <p class="home-section-lead">Hao Wang 代表作 · 从具体研究问题，走向可追溯的方法与证据。</p>
        </div>
        <span class="home-section-aside">5 SELECTED WORKS</span>
      </div>
      <SelectedPublications pubs={selected} />
    </div>
  </section>

  <!-- Life in the lab -->
  <section class="border-t border-slate-200 bg-white">
    <div class="container-page py-16">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-2xl text-slate-900">Life in the lab</h2>
          <p class="mt-4 max-w-prose text-slate-600">
            Science is a team sport. Beyond the bench, we celebrate milestones,
            travel to conferences, and get out together. Add your own photos in
            <code>src/content/gallery/</code>.
          </p>
          <a
            href="/lab-life"
            class="group mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
          >
            Explore lab life
            <span
              class="transition-transform group-hover:translate-x-0.5"
              aria-hidden="true">&rarr;</span
            >
          </a>
        </div>
        <a
          href="/lab-life"
          class="group block overflow-hidden rounded-2xl border border-slate-200 shadow-sm"
        >
          <Image
            src={labPhoto}
            alt="Lab team photo"
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
          />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .architecture-section { border-bottom:1px solid #e2e8f0; background:linear-gradient(180deg,#f7fafd,#f4f8fc 75%,#f9fbfd); }
  .home-section-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:1.5rem; }
  .home-section-lead { margin-top:.7rem; font-size:.875rem; line-height:1.9; color:#526780; }
  .home-section-aside { flex-shrink:0; font-size:.65rem; line-height:1.8; letter-spacing:.08em; color:#6a7f96; }
  @media(max-width:639px) { .home-section-heading{align-items:flex-start;flex-direction:column;gap:.8rem;} .home-section-heading h2{font-size:1.75rem;} .home-section-lead{font-size:.82rem;} }
</style>
