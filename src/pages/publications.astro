---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SelectedPublications from "../components/SelectedPublications.astro";
import { getPublications } from "../lib/content";
import { citationCatalog, comparePublicationsByCitations } from "../data/publication-catalog";

const pubs = (await getPublications())
  .filter(publication => Boolean(publication.data.catalogId))
  .sort(comparePublicationsByCitations);
const years = [...new Set(pubs.map(publication => publication.data.year))].sort((a, b) => b - a);
const categories = [...new Set(pubs.map(publication => publication.data.category).filter((category): category is string => Boolean(category)))];
---

<BaseLayout title="论文" description="StarTeam 论文目录。">
  <PageHeader
    eyebrow="研究成果"
    title="论文"
    lead={`${citationCatalog.period} StarTeam 研究成果。`}
  />
  <div class="container-page catalog-page py-10 sm:py-12">
    <div class="catalog-provenance" lang="zh-CN">
      <div class="catalog-snapshot">
        <p><strong>{pubs.length}</strong> 篇目录记录</p>
        <p class="catalog-as-of">引用快照日期：<time datetime={citationCatalog.asOf}>{citationCatalog.asOf}</time><span aria-hidden="true"> · </span>{citationCatalog.name}</p>
      </div>
    </div>

    <form class="catalog-controls" id="pub-filters" role="search" aria-label="检索论文目录">
      <div class="catalog-search-field">
        <label for="pub-search">搜索</label>
        <input id="pub-search" type="search" name="search" autocomplete="off" placeholder="标题、作者、研究主题、分类或年份" aria-controls="pub-list" />
      </div>
      <div class="catalog-select-field">
        <label for="pub-year">年份</label>
        <select id="pub-year" name="year" aria-controls="pub-list">
          <option value="all">全部年份</option>
          {years.map(year => <option value={year}>{year}</option>)}
        </select>
      </div>
      <div class="catalog-select-field">
        <label for="pub-category">分类</label>
        <select id="pub-category" name="category" aria-controls="pub-list">
          <option value="all">全部分类</option>
          {categories.map(category => <option value={category}>{category}</option>)}
        </select>
      </div>
      <div class="catalog-select-field">
        <label for="pub-sort">排序</label>
        <select id="pub-sort" name="sort" aria-controls="pub-list">
          <option value="citations" selected>引用数</option>
          <option value="newest">最新年份</option>
        </select>
      </div>
      <div class="catalog-controls-footer">
        <p id="pub-count" role="status" aria-live="polite" aria-atomic="true">显示 {pubs.length} / {pubs.length} 篇</p>
        <button type="button" id="pub-reset">重置筛选</button>
      </div>
    </form>

    <SelectedPublications pubs={pubs} id="pub-list" />
    <p id="pub-empty" class="catalog-empty" hidden lang="zh-CN">没有符合条件的论文。请尝试更换关键词、年份或分类。</p>
  </div>

  <script>
    import { comparePublicationsByCitations } from "../data/publication-catalog";

    const list = document.getElementById("pub-list");
    const items = list ? [...list.querySelectorAll<HTMLElement>("[data-pub]")] : [];
    const form = document.getElementById("pub-filters");
    const search = document.getElementById("pub-search") as HTMLInputElement | null;
    const year = document.getElementById("pub-year") as HTMLSelectElement | null;
    const category = document.getElementById("pub-category") as HTMLSelectElement | null;
    const sort = document.getElementById("pub-sort") as HTMLSelectElement | null;
    const count = document.getElementById("pub-count");
    const empty = document.getElementById("pub-empty");
    const normalize = (value: string) => value.normalize("NFKC").toLowerCase().trim();
    const sortable = (item: HTMLElement) => ({
      data: {
        citations: item.dataset.citationKnown === "true" ? Number(item.dataset.citations) : undefined,
        year: Number(item.dataset.year),
        catalogId: item.dataset.catalogId,
      },
    });

    function applyFilters() {
      const terms = normalize(search?.value ?? "").split(/\s+/).filter(Boolean);
      const selectedYear = year?.value ?? "all";
      const selectedCategory = category?.value ?? "all";
      let visible = 0;
      for (const item of items) {
        const matches = terms.every(term => (item.dataset.search ?? "").includes(term))
          && (selectedYear === "all" || item.dataset.year === selectedYear)
          && (selectedCategory === "all" || item.dataset.category === selectedCategory);
        item.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = `显示 ${visible} / ${items.length} 篇`;
      if (empty) empty.hidden = visible !== 0;
    }

    function applySort() {
      if (!list) return;
      const newest = sort?.value === "newest";
      const sorted = [...items].sort((a, b) => {
        const aa = sortable(a);
        const bb = sortable(b);
        return (newest ? bb.data.year - aa.data.year : 0) || comparePublicationsByCitations(aa, bb);
      });
      const fragment = document.createDocumentFragment();
      sorted.forEach(item => fragment.appendChild(item));
      list.appendChild(fragment);
    }

    form?.addEventListener("submit", event => event.preventDefault());
    search?.addEventListener("input", applyFilters);
    year?.addEventListener("change", applyFilters);
    category?.addEventListener("change", applyFilters);
    sort?.addEventListener("change", applySort);
    document.getElementById("pub-reset")?.addEventListener("click", () => {
      if (search) search.value = "";
      if (year) year.value = "all";
      if (category) category.value = "all";
      if (sort) sort.value = "citations";
      applySort();
      applyFilters();
    });
    applyFilters();
  </script>
</BaseLayout>

<style>
  .catalog-page { min-width: 0; }
  .catalog-provenance { margin-bottom: 2rem; border-left: 2px solid var(--color-primary-200, #aed3ef); padding-left: 1rem; color: var(--color-slate-600, #475569); font-size: 0.9rem; line-height: 1.85; }
  .catalog-snapshot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; }
  .catalog-snapshot p { min-width: 0; }
  .catalog-snapshot strong { color: var(--color-primary-900, #0d3252); font-weight: 600; }
  .catalog-snapshot span { margin: 0 0.4rem; color: var(--color-slate-400, #94a3b8); }
  .catalog-as-of { font-size: 0.82rem; }
  .catalog-controls { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 0.7fr) minmax(0, 1fr) minmax(0, 1.1fr); align-items: end; gap: 1rem; margin-bottom: 1.75rem; }
  .catalog-controls>div { min-width: 0; }
  .catalog-controls label { display: block; margin-bottom: 0.4rem; color: var(--color-slate-600, #475569); font-size: 0.85rem; font-weight: 500; line-height: 1.6; }
  .catalog-controls input,.catalog-controls select { display: block; width: 100%; min-width: 0; max-width: 100%; border: 1px solid var(--color-slate-300, #cbd5e1); border-radius: 0.45rem; background: #fff; padding: 0.65rem 0.75rem; color: var(--color-slate-700, #334155); font: inherit; font-size: 0.9rem; line-height: 1.6; }
  .catalog-controls input:focus,.catalog-controls select:focus { border-color: var(--color-primary-500, #1f73b8); }
  .catalog-controls input::placeholder { color: var(--color-slate-400, #94a3b8); }
  .catalog-controls-footer { grid-column: 1/-1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 1rem; color: var(--color-slate-500, #64748b); font-size: 0.85rem; line-height: 1.8; }
  .catalog-controls-footer button { border: 0; border-bottom: 1px solid var(--color-primary-200, #aed3ef); padding: 0; background: none; color: var(--color-primary-700, #124d80); font: inherit; cursor: pointer; }
  .catalog-controls-footer button:hover { color: var(--color-accent-700, #97226b); border-color: currentColor; }
  .catalog-empty { padding: 3rem 0; color: var(--color-slate-600, #475569); text-align: center; font-size: 0.95rem; line-height: 1.9; }
  .catalog-empty[hidden] { display: none; }
  @media(max-width: 1023px) {
    .catalog-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .catalog-search-field { grid-column: 1/-1; }
  }
  @media(max-width: 479px) {
    .catalog-controls { grid-template-columns: minmax(0, 1fr); gap: 0.85rem; }
    .catalog-search-field { grid-column: auto; }
    .catalog-provenance { padding-left: 0.75rem; }
    .catalog-snapshot { flex-direction: column; }
  }
</style>
