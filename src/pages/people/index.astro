---
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
---

<BaseLayout
  title="团队"
  description="StarTeam 团队成员。"
>
  <PageHeader
    eyebrow="StarTeam"
    title="团队"
  />
  <div class="container-page py-12">
    {groups.map((g) => <PersonGroup title={g.group === "Faculty" ? "教师" : g.group} people={g.people} />)}
  </div>
</BaseLayout>
